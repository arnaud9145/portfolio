# Numéro affiché par le bouton "Révéler le numéro" (jamais en HTML/bundle)
PHONE_NUMBER=
# Clé API Resend pour le formulaire de contact
RESEND_API_KEY=
# Destinataire des messages du formulaire
CONTACT_TO_EMAIL=
# Expéditeur (optionnel) — une fois un domaine vérifié dans Resend, ex.
# "Portfolio <contact@dufour.build>". Sinon fallback sur onboarding@resend.dev.
CONTACT_FROM_EMAIL=
